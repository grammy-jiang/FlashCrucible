{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CLIResponse",
  "description": "Standard CLI response envelope used with --output json",
  "schema_version": "v1",
  "type": "object",
  "required": ["schema_version","status","command","message","data"],
  "properties": {
    "schema_version": {"type": "string"},
    "status": {"type": "string","enum": ["ok","fail","error","aborted"]},
    "command": {"type": "string"},
    "run_id": {"type": ["string","null"]},
    "device": {"type": ["object","null"]},
    "error_code": {"type": ["string","null"]},
    "message": {"type": "string"},
    "data": {"type": "object"},
    "log_path": {"type": ["string","null"]}
  },
  "additionalProperties": false
}
