{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flashcrucible.local/schemas/history_entry.schema.json",
  "title": "TFQA history entry",
  "description": "Schema for a single run entry in the history log.",
  "schema_version": 1,
  "type": "object",
  "required": [
    "timestamp",
    "run_id",
    "command",
    "device_path",
    "status",
    "message",
    "stage_count",
    "metadata"
  ],
  "properties": {
    "timestamp": {"type": "string", "format": "date-time"},
    "run_id": {"type": "string"},
    "command": {"type": "string"},
    "device_path": {"type": "string"},
    "status": {"type": "string"},
    "message": {"type": "string"},
    "stage_count": {"type": "integer", "minimum": 0},
    "profile": {"type": ["string", "null"]},
    "log_path": {"type": ["string", "null"]},
    "metadata": {"type": "object"}
  },
  "additionalProperties": true
}
