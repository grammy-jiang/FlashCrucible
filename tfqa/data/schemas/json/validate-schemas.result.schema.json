{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flashcrucible.local/schemas/validate-schemas.result.schema.json",
  "title": "tfqa validate-schemas result",
  "description": "Result of parsing each shipped schema. Validates CLIResponse.data for `tfqa validate-schemas`; the envelope itself is cli_response.schema.json.",
  "schema_version": 1,
  "type": "object",
  "properties": {
    "validated": {
      "type": "integer"
    },
    "failed": {
      "type": "integer"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true,
  "required": [
    "validated",
    "failed",
    "files"
  ]
}
