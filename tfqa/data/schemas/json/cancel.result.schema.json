{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flashcrucible.local/schemas/cancel.result.schema.json",
  "title": "tfqa cancel result",
  "description": "Result of stopping a background run. Validates the whole CLIResponse for `tfqa cancel`. The shape of `data` depends on `status`, so it is constrained conditionally: an error response carries `details` or nothing.",
  "schema_version": 2,
  "type": "object",
  "required": [
    "status",
    "command",
    "message",
    "data"
  ],
  "properties": {
    "status": {
      "enum": [
        "ok",
        "fail",
        "error",
        "aborted"
      ]
    },
    "command": {
      "const": "cancel"
    },
    "data": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "fail"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "run"
            ],
            "properties": {
              "run": {
                "type": "object",
                "required": [
                  "run_id",
                  "command",
                  "state"
                ],
                "properties": {
                  "run_id": {
                    "type": "string"
                  },
                  "command": {
                    "type": "string"
                  },
                  "state": {
                    "enum": [
                      "running",
                      "completed",
                      "failed",
                      "cancelled",
                      "orphaned"
                    ]
                  },
                  "pid": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "device_path": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "phase": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "completed_bytes": {
                    "type": "integer"
                  },
                  "total_bytes": {
                    "type": "integer"
                  },
                  "percent": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "running": {
                    "type": "boolean"
                  },
                  "started_at": {
                    "type": "number"
                  },
                  "updated_at": {
                    "type": "number"
                  },
                  "finished_at": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "exit_code": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "error_code": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "message": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "metrics": {
                    "type": "object"
                  },
                  "wrote_to_device": {
                    "type": "boolean",
                    "description": "True if the run had begun writing; its contents are partial if it did not complete."
                  }
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "details": {
                "type": "object"
              }
            },
            "additionalProperties": true
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
