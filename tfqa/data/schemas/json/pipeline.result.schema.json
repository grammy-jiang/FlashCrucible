{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flashcrucible.local/schemas/pipeline.result.schema.json",
  "title": "tfqa pipeline result",
  "description": "An orchestrated run of several stages. Validates CLIResponse.data for `tfqa pipeline`; the envelope itself is cli_response.schema.json.",
  "schema_version": 1,
  "type": "object",
  "properties": {
    "plan": {
      "type": "object",
      "description": "What the command would do; present only under --dry-run.",
      "required": [
        "device"
      ],
      "properties": {
        "safety": {
          "type": "object",
          "required": [
            "would_run",
            "error_code",
            "reason",
            "details"
          ],
          "properties": {
            "would_run": {
              "type": "boolean"
            },
            "error_code": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "details": {
              "type": "object"
            }
          }
        }
      },
      "additionalProperties": true
    },
    "stage_plan": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requested_stage_plan": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "metadata": {
      "type": "object"
    },
    "combo": {
      "type": [
        "object",
        "null"
      ]
    },
    "image_options": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
