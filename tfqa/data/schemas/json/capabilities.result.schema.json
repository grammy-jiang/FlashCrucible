{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flashcrucible.local/schemas/capabilities.result.schema.json",
  "title": "tfqa capabilities result",
  "description": "Which external tools and features this host supports. Validates CLIResponse.data for `tfqa capabilities`; the envelope itself is cli_response.schema.json.",
  "schema_version": 1,
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "external_tools": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "available"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "features": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "required": [
    "external_tools"
  ]
}
