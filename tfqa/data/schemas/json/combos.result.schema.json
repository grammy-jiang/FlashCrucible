{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flashcrucible.local/schemas/combos.result.schema.json",
  "title": "tfqa combos result",
  "description": "Curated workflow combos. Validates CLIResponse.data for `tfqa combos`; the envelope itself is cli_response.schema.json.",
  "schema_version": 1,
  "type": "object",
  "properties": {
    "combos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "stages"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "profile": {
            "type": [
              "string",
              "null"
            ]
          },
          "stages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "image_options": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": true,
  "required": [
    "combos"
  ]
}
