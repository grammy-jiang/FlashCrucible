{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flashcrucible.local/schemas/workload-smallfiles.result.schema.json",
  "title": "tfqa workload-smallfiles result",
  "description": "Small-file create, read, and delete workload. Validates the whole CLIResponse for `tfqa workload-smallfiles`. The shape of `data` depends on `status`, so it is constrained conditionally: an error response carries `details` or nothing.",
  "schema_version": 2,
  "type": "object",
  "required": [
    "status",
    "command",
    "message",
    "data"
  ],
  "properties": {
    "status": {
      "enum": [
        "ok",
        "fail",
        "error",
        "aborted"
      ]
    },
    "command": {
      "const": "workload-smallfiles"
    },
    "data": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "fail"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "result"
                ],
                "properties": {
                  "result": {
                    "type": "object",
                    "required": [
                      "name",
                      "status",
                      "metrics"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "status": {
                        "enum": [
                          "ok",
                          "fail",
                          "failed",
                          "skipped",
                          "warning",
                          "error"
                        ]
                      },
                      "started_at": {
                        "type": "string"
                      },
                      "finished_at": {
                        "type": "string"
                      },
                      "duration_seconds": {
                        "type": "number"
                      },
                      "metrics": {
                        "type": "object",
                        "description": "Measured values only. An engine that cannot measure refuses rather than estimating.",
                        "additionalProperties": {
                          "type": [
                            "number",
                            "integer",
                            "boolean",
                            "string"
                          ]
                        }
                      },
                      "details": {
                        "type": "object"
                      },
                      "warnings": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "logs_path": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "additionalProperties": true
              },
              {
                "type": "object",
                "required": [
                  "plan"
                ],
                "properties": {
                  "plan": {
                    "type": "object",
                    "required": [
                      "device"
                    ],
                    "properties": {
                      "device": {
                        "type": "string"
                      },
                      "safety": {
                        "type": "object",
                        "required": [
                          "would_run",
                          "error_code",
                          "reason",
                          "details"
                        ],
                        "properties": {
                          "would_run": {
                            "type": "boolean"
                          },
                          "error_code": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "reason": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "details": {
                            "type": "object"
                          }
                        }
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "additionalProperties": true
              }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "details": {
                "type": "object"
              }
            },
            "additionalProperties": true
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
