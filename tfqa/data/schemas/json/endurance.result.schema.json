{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flashcrucible.local/schemas/endurance.result.schema.json",
  "title": "tfqa endurance result",
  "description": "Repeated destructive write-and-verify passes. Validates the whole CLIResponse for `tfqa endurance`. The shape of `data` depends on `status`, so it is constrained conditionally: an error response carries `details` or nothing.",
  "schema_version": 2,
  "type": "object",
  "required": [
    "status",
    "command",
    "message",
    "data"
  ],
  "properties": {
    "status": {
      "enum": [
        "ok",
        "fail",
        "error",
        "aborted"
      ]
    },
    "command": {
      "const": "endurance"
    },
    "data": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "fail"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "result"
                ],
                "properties": {
                  "result": {
                    "type": "object",
                    "required": [
                      "name",
                      "status",
                      "metrics"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "status": {
                        "enum": [
                          "ok",
                          "fail",
                          "failed",
                          "skipped",
                          "warning",
                          "error"
                        ]
                      },
                      "started_at": {
                        "type": "string"
                      },
                      "finished_at": {
                        "type": "string"
                      },
                      "duration_seconds": {
                        "type": "number"
                      },
                      "metrics": {
                        "type": "object",
                        "description": "Measured values only. An engine that cannot measure refuses rather than estimating.",
                        "additionalProperties": {
                          "type": [
                            "number",
                            "integer",
                            "boolean",
                            "string"
                          ]
                        }
                      },
                      "details": {
                        "type": "object",
                        "description": "Per-pass measurements, the stop reason, and the wear delta.",
                        "properties": {
                          "stopped_because": {
                            "type": "string"
                          },
                          "span_bytes": {
                            "type": "integer"
                          },
                          "wrapped": {
                            "type": "boolean"
                          },
                          "passes": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "required": [
                                "index",
                                "bytes_written",
                                "mismatches"
                              ],
                              "properties": {
                                "index": {
                                  "type": "integer"
                                },
                                "bytes_written": {
                                  "type": "integer"
                                },
                                "bytes_verified": {
                                  "type": "integer"
                                },
                                "mismatches": {
                                  "type": "integer"
                                },
                                "wrapped": {
                                  "type": "boolean"
                                },
                                "duration_seconds": {
                                  "type": "number"
                                },
                                "write_throughput_mbps": {
                                  "type": "number"
                                },
                                "verify_throughput_mbps": {
                                  "type": "number"
                                },
                                "issues": {
                                  "type": "array",
                                  "items": {
                                    "type": "string"
                                  }
                                }
                              },
                              "additionalProperties": true
                            }
                          },
                          "wear": {
                            "type": "object",
                            "description": "The card's own counters before and after, or available:false with the reason. Never an estimate.",
                            "required": [
                              "available"
                            ],
                            "properties": {
                              "available": {
                                "type": "boolean"
                              }
                            },
                            "additionalProperties": true
                          }
                        },
                        "additionalProperties": true
                      },
                      "warnings": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "logs_path": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "additionalProperties": true
              },
              {
                "type": "object",
                "required": [
                  "plan"
                ],
                "properties": {
                  "plan": {
                    "type": "object",
                    "required": [
                      "device"
                    ],
                    "properties": {
                      "device": {
                        "type": "string"
                      },
                      "safety": {
                        "type": "object",
                        "required": [
                          "would_run",
                          "error_code",
                          "reason",
                          "details"
                        ],
                        "properties": {
                          "would_run": {
                            "type": "boolean"
                          },
                          "error_code": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "reason": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "details": {
                            "type": "object"
                          }
                        }
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "additionalProperties": true
              },
              {
                "type": "object",
                "description": "Emitted by --detach: the run was started in the background and has produced no result yet. Poll `tfqa status <run_id>` for the outcome.",
                "required": [
                  "run_id",
                  "detached"
                ],
                "properties": {
                  "run_id": {
                    "type": "string"
                  },
                  "pid": {
                    "type": "integer"
                  },
                  "detached": {
                    "const": true
                  }
                },
                "additionalProperties": true
              }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "details": {
                "type": "object"
              }
            },
            "additionalProperties": true
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
