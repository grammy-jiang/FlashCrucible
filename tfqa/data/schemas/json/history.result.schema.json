{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flashcrucible.local/schemas/history.result.schema.json",
  "title": "tfqa history result",
  "description": "Recorded runs, most recent first. Validates CLIResponse.data for `tfqa history`; the envelope itself is cli_response.schema.json.",
  "schema_version": 1,
  "type": "object",
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "run_id",
          "command",
          "status"
        ],
        "properties": {
          "timestamp": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "device_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "stage_count": {
            "type": "integer"
          },
          "profile": {
            "type": [
              "string",
              "null"
            ]
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    }
  },
  "additionalProperties": true,
  "required": [
    "entries"
  ]
}
