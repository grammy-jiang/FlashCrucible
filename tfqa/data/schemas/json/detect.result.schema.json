{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flashcrucible.local/schemas/detect.result.schema.json",
  "title": "tfqa detect result",
  "description": "Block devices discovered on the host. Validates CLIResponse.data for `tfqa detect`; the envelope itself is cli_response.schema.json.",
  "schema_version": 1,
  "type": "object",
  "properties": {
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "size_bytes",
          "is_removable",
          "is_system_disk"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "vendor": {
            "type": [
              "string",
              "null"
            ]
          },
          "serial": {
            "type": [
              "string",
              "null"
            ]
          },
          "size_bytes": {
            "type": "integer"
          },
          "is_removable": {
            "type": "boolean"
          },
          "is_system_disk": {
            "type": "boolean"
          },
          "mountpoints": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "transport": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": true,
  "required": [
    "devices"
  ]
}
