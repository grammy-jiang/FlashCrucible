{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flashcrucible.local/schemas/health.result.schema.json",
  "title": "tfqa health result",
  "description": "Card identity and wear, with the source of each value. Validates CLIResponse.data for `tfqa health`; the envelope itself is cli_response.schema.json.",
  "schema_version": 1,
  "type": "object",
  "properties": {
    "device": {
      "type": "object"
    },
    "snapshot": {
      "type": "object",
      "required": [
        "source",
        "available",
        "cid",
        "health",
        "sources"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "available": {
          "type": "boolean",
          "description": "False when no source produced wear data."
        },
        "cid": {
          "type": "object"
        },
        "health": {
          "type": "object"
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "available"
            ],
            "properties": {
              "available": {
                "type": "boolean"
              },
              "error_code": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "details": {
          "type": "object"
        }
      }
    }
  },
  "additionalProperties": true,
  "required": [
    "snapshot"
  ]
}
